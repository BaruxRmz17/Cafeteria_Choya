---
import Layout from '../layouts/Layout.astro';
import RoomsSection from '../components/ui/habitaciones/Habitaciones';
import '../styles/global.css';
---

<Layout title="Habitaciones - Landing Hotel">
  <main class="min-h-screen bg-white">
    <!-- Hero limpio -->
    <section class="relative h-[50vh] flex items-center justify-center overflow-hidden">
      <img
        src="/src/assets/Images/habitacionebg.webp"
        alt="Hotel Room Hero"
        class="absolute inset-0 w-full h-full object-cover brightness-75"
      />
      <div class="relative z-10 text-center text-white px-4">
        <h1 class="text-4xl md:text-6xl font-serif font-extrabold mb-2 drop-shadow-lg">
          Habitaciones de Ensueño
        </h1>
        <p class="text-lg md:text-xl drop-shadow-sm">Confort y estilo para cada momento</p>
      </div>
    </section>

    <!-- Rooms Section -->
    <RoomsSection client:load />
  </main>
</Layout>
