---
import Layout from '../layouts/Layout.astro';
import ContactSection from '../components/ui/Contacto/Contacto.tsx';
import '../styles/global.css';
---

<Layout title="Contacto - Landing Hotel">
<main class="min-h-screen bg-gray-100">
    <!-- Hero Section -->
    <section class="relative h-[60vh] bg-blue-700 text-white flex items-center justify-center">
    <div class="absolute inset-0 bg-black/40 z-10"></div>
    <img
        src="/src/assets/Images/con.avif"
        alt="Hotel Contact Hero"
        class="absolute inset-0 w-full h-full object-cover"
    />
    <div class="relative z-20 text-center">
        <h1 class="text-4xl md:text-6xl font-serif font-bold mb-4">Contacto</h1>
        <p class="text-lg md:text-xl">Estamos aquí para ayudarte en todo momento</p>
    </div>
    </section>

    <!-- Contact Section -->
    <ContactSection client:load />
</main>
</Layout>