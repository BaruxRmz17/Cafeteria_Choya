---
import Layout from '../layouts/Layout.astro';
import LocationsSection from '../components/ui/Ubicacion/Ubicaciones';
import '../styles/global.css';
---

<Layout title="Ubicaciones - Landing Hotel">
<main class="min-h-screen bg-gray-100">
    <!-- Hero Section -->
    <section class="relative h-[60vh] bg-blue-700 text-white flex items-center justify-center">
    <div class="absolute inset-0 bg-black/40 z-10"></div>
    <img
        src="/src/assets/Images/fachadaH.webp"
        alt="Hotel Location Hero"
        class="absolute inset-0 w-full h-full object-cover"
    />
    <div class="relative z-20 text-center">
        <h1 class="text-4xl md:text-6xl font-serif font-bold mb-4">Nuestras Ubicaciones</h1>
        <p class="text-lg md:text-xl">Explora nuestros destinos y encuentra tu lugar ideal</p>
    </div>
    </section>

    <!-- Locations Section -->
    <LocationsSection client:load />
</main>
</Layout>
