---
import Layout from '@/src/layouts/Layout.astro';
import { HotelCardsCarousel } from '@/src/components/ui/carrusel_ex/HotelCardsCarousel';
import { LayoutGrid } from '@/src/components/ui/galeria/galeria';
import { Cartas } from '@/src/components/ui/galeria/cartas';
import Button from '../components/ui/Button';





import "../styles/global.css";
---

<Layout title="Inicio">
    <!-- Hero Section -->
    <section class="pt-[120px] min-h-screen flex items-center justify-center bg-gradient-to-r from-slate-100 to-gray-200 px-4">
        <div class="container mx-auto grid grid-cols-1 md:grid-cols-2 gap-12 items-center">
            <!-- Texto -->
            <div class="text-center md:text-left">
                <h1 class="text-5xl md:text-6xl font-extrabold leading-tight text-gray-800 mb-6">
                    Descubre Tu <span class="text-amber-500">Estancia Perfecta</span>
                </h1>
            <p class="text-lg md:text-xl text-gray-600 mb-8 max-w-xl mx-auto md:mx-0">
                Vive una experiencia inolvidable en nuestros hoteles de lujo, diseñados para ofrecer confort, relajación y exclusividad.
            </p>
            <a
                href="/Habitacion"
                class="inline-block bg-amber-500 text-white text-lg font-semibold px-8 py-3 rounded-full shadow-md hover:bg-amber-600 transition duration-300"
            >
                Reservar Ahora
            </a>
            </div>
    
            <!-- Imagen -->
            <div class="w-full">
                <img
                src="src/assets/Images/hoteles.avif"
                alt="Hotel exterior"
                class="w-full h-96 object-cover rounded-2xl shadow-2xl border-4 border-white"
            />
            </div>
        </div>
    </section>
    

    <!--  Resumen de Servicios  -->
    <section class="py-8 bg-white">
        <HotelCardsCarousel client:load />
    </section>

    <section class="py-12 bg-white"> 
        <h2 class=" text-center  text-5xl md:text-6xl font-extrabold leading-tight text-gray-800 mb-6" >
            Descubre <span class="text-amber-500">Nuestra Galeria</span>
        </h2>        
        <LayoutGrid cards={Cartas} client:load />
    </section>




    <!-- Contactanos Button -->
    <section class="py-20 bg-gradient-to-r from-slate-100 to-gray-200">
        <div class="max-w-7xl mx-auto text-center flex flex-col items-center">
            <h2 class="text-gray-800 text-xl md:text-5xl font-bold font-sans mb-6">Reserva Ahora</h2>
            <p class="text-amber-500 text-base md:text-lg max-w-2xl mx-auto mb-8">
                ¿Tienes alguna pregunta o deseas hacer una reserva? Nuestro equipo está aquí para ayudarte. ¡Ponte en contacto con nosotros hoy mismo!
            </p>
            <div class="flex justify-center w-full">
                <Button client:load />
            </div>
        </div>
    </section>
</Layout>