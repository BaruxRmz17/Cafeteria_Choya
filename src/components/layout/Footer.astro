---
import { motion } from 'framer-motion';
---

<footer class="bg-gradient-to-b from-gray-900 to-gray-950 text-white py-12">
  <div class="container mx-auto px-6">
    <div class="flex flex-col md:flex-row justify-between items-center md:items-start gap-12">
      <!-- Brand/Logo -->
      <div class="text-center md:text-left">
        <a href="/" class="text-3xl font-serif font-bold text-amber-400">Landing Hotel</a>
        <p class="mt-3 text-sm opacity-80 text-gray-300">Tu escapada perfecta comienza aquí.</p>
      </div>

      <!-- Quick Links -->
      <div>
        <h3 class="text-xl font-serif font-semibold mb-6 text-center md:text-left text-amber-400">Enlaces Rápidos</h3>
        <ul class="flex flex-col items-center md:items-start space-y-3">
          <motion.li whileHover={{ scale: 1.05 }} className="relative">
            <a href="/Home" class="block py-1 text-gray-200 hover:text-amber-400 transition-colors duration-300">
              Inicio
            </a>
            <motion.div
              className="absolute bottom-0 left-0 h-0.5 bg-amber-400"
              initial={{ width: "0%", left: "50%" }}
              whileHover={{ width: "100%", left: "0%" }}
              transition={{ duration: 0.4, ease: "easeInOut" }}
            />
          </motion.li>
          <motion.li whileHover={{ scale: 1.05 }} className="relative">
            <a href="/Habitacion" class="block py-1 text-gray-200 hover:text-amber-400 transition-colors duration-300">
              Habitacion
            </a>
            <motion.div
              className="absolute bottom-0 left-0 h-0.5 bg-amber-400"
              initial={{ width: "0%", left: "50%" }}
              whileHover={{ width: "100%", left: "0%" }}
              transition={{ duration: 0.4, ease: "easeInOut" }}
            />
          </motion.li>
          <motion.li whileHover={{ scale: 1.05 }} className="relative">
            <a href="/Ofertas" class="block py-1 text-gray-200 hover:text-amber-400 transition-colors duration-300">
              Ofertas
            </a>
            <motion.div
              className="absolute bottom-0 left-0 h-0.5 bg-amber-400"
              initial={{ width: "0%", left: "50%" }}
              whileHover={{ width: "100%", left: "0%" }}
              transition={{ duration: 0.4, ease: "easeInOut" }}
            />
          </motion.li>
          <motion.li whileHover={{ scale: 1.05 }} className="relative">
            <a href="/Ubicaciones" class="block py-1 text-gray-200 hover:text-amber-400 transition-colors duration-300">
              Ubicaciones
            </a>
            <motion.div
              className="absolute bottom-0 left-0 h-0.5 bg-amber-400"
              initial={{ width: "0%", left: "50%" }}
              whileHover={{ width: "100%", left: "0%" }}
              transition={{ duration: 0.4, ease: "easeInOut" }}
            />
          </motion.li>
          <motion.li whileHover={{ scale: 1.05 }} className="relative">
            <a href="/Nosotros" class="block py-1 text-gray-200 hover:text-amber-400 transition-colors duration-300">
              Sobre Nosotros
            </a>
            <motion.div
              className="absolute bottom-0 left-0 h-0.5 bg-amber-400"
              initial={{ width: "0%", left: "50%" }}
              whileHover={{ width: "100%", left: "0%" }}
              transition={{ duration: 0.4, ease: "easeInOut" }}
            />
          </motion.li>
          <motion.li whileHover={{ scale: 1.05 }} className="relative">
            <a href="/Contacto" class="block py-1 text-gray-200 hover:text-amber-400 transition-colors duration-300">
              Contacto
            </a>
            <motion.div
              className="absolute bottom-0 left-0 h-0.5 bg-amber-400"
              initial={{ width: "0%", left: "50%" }}
              whileHover={{ width: "100%", left: "0%" }}
              transition={{ duration: 0.4, ease: "easeInOut" }}
            />
          </motion.li>
        </ul>
      </div>

      <!-- Contact Info & Social Media -->
      <div class="text-center md:text-right">
        <h3 class="text-xl font-serif font-semibold mb-6 text-amber-400">Contáctanos</h3>
        <p class="text-sm opacity-80 text-gray-300">Email: info@hotelhaven.com</p>
        <p class="text-sm opacity-80 mt-2 text-gray-300">Teléfono: +123 456 7890</p>
        <div class="flex justify-center md:justify-end space-x-6 mt-6">
          <motion.a
            href="https://instagram.com"
            target="_blank"
            rel="noopener noreferrer"
            whileHover={{ scale: 1.3, rotate: 15 }}
            whileTap={{ scale: 0.9 }}
            className="text-gray-200 hover:text-amber-400 transition-colors duration-300"
          >
            <svg class="w-7 h-7" fill="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
              <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.982-6.98.059-1.281.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.948-.196-4.354-2.617-6.78-6.979-6.982-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
            </svg>
          </motion.a>
          <motion.a
            href="https://facebook.com"
            target="_blank"
            rel="noopener noreferrer"
            whileHover={{ scale: 1.3, rotate: 15 }}
            whileTap={{ scale: 0.9 }}
            className="text-gray-200 hover:text-amber-400 transition-colors duration-300"
          >
            <svg class="w-7 h-7" fill="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
              <path d="M22.675 0h-21.35c-.732 0-1.325.593-1.325 1.325v21.351c0 .731.593 1.324 1.325 1.324h11.495v-9.294h-3.128v-3.622h3.128v-2.671c0-3.1 1.893-4.788 4.659-4.788 1.325 0 2.463.099 2.795.143v3.24l-1.918.001c-1.504 0-1.795.715-1.795 1.763v2.313h3.587l-.467 3.622h-3.12v9.293h6.116c.73 0 1.323-.593 1.323-1.325v-21.35c0-.732-.593-1.325-1.325-1.325zm0 0"/>
            </svg>
          </motion.a>
        </div>
      </div>
    </div>

    <!-- Decorative Divider -->
    <div class="mt-12 flex justify-center">
      <div class="w-24 h-1 bg-gradient-to-r from-transparent via-amber-400 to-transparent"></div>
    </div>

    <!-- Copyright -->
    <div class="mt-6 pt-4 text-center text-sm opacity-80 text-gray-300">
      <p>© 2025 Hotel Haven. Todos los derechos reservados.</p>
    </div>
  </div>
</footer>